# -----------------------------------------------------------------------------
# OmniStore AI - Environment Variables Configuration
# -----------------------------------------------------------------------------

# Application
PROJECT_NAME="AI-Powered E-Commerce Shopping Assistant"
VERSION="1.0.0"

# Database Configuration
# In Docker Compose, use PostgreSQL service:
DATABASE_URL="postgresql://postgres:postgrespassword2026@localhost:5432/ecommerce_db"
# Set FORCE_SQLITE to "true" for zero-configuration local dev without PostgreSQL installed:
FORCE_SQLITE="true"

# Security & Authentication
SECRET_KEY="super-secret-production-quality-jwt-signing-key-2026"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI & LLM Provider ("mock", "openai", "gemini", or "groq")
# Default "mock" enables instant deterministic high-quality multi-agent responses without API keys!
LLM_PROVIDER="mock"
LLM_MODEL="gpt-4o-mini"

# Optional External API Keys (Uncomment to use live LLMs)
# OPENAI_API_KEY="sk-..."
# GEMINI_API_KEY="AIzaSy..."
# GROQ_API_KEY="gsk_..."

# RAG & Semantic Search
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.35
