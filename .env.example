# ==============================================================================
# AI-Powered E-Commerce Shopping Assistant — Environment Configuration
# ==============================================================================

# Application Meta
APP_NAME="AI-Powered E-Commerce Shopping Assistant"
APP_ENV="development"
PORT=8080

# PostgreSQL Database & pgvector
SPRING_DATASOURCE_URL="jdbc:postgresql://localhost:5432/ecommerce_db"
SPRING_DATASOURCE_USERNAME="postgres"
SPRING_DATASOURCE_PASSWORD="postgrespassword2026"
POSTGRES_DB="ecommerce_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgrespassword2026"

# Redis Distributed Cache & Conversation State
SPRING_DATA_REDIS_HOST="localhost"
SPRING_DATA_REDIS_PORT=6379

# Security & JWT Tokens (HMAC-SHA256 256-bit Hex)
APP_SECURITY_JWT_SECRET="9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b"
APP_SECURITY_JWT_EXPIRATION_MS=86400000

# Spring AI & OpenAI Configuration (Optional for live LLM inference; fallback deterministic hashing active)
APP_AI_OPENAI_API_KEY="sk-your-openai-api-key"
APP_AI_AGENT_MAX_STEPS=5
APP_AI_AGENT_TOOL_TIMEOUT_SECONDS=10

# Human Approval Expiring Token TTL (seconds)
APP_APPROVAL_EXPIRY_SECONDS=900

# Angular Frontend Configuration
FRONTEND_PORT=4200
API_BASE_URL="http://localhost:8080/api"
